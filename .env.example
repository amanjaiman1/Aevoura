# ─────────────────────────────────────────────────────────────────────────────
# AEVOURA — environment
#
# Copy to `.env.local` and fill in what you need. Nothing here is required for
# the site to build, render or deploy. Without a delivery provider the enquiry
# form stays honest: it returns a 501, and the form offers the visitor a
# pre-filled email instead of pretending the message was sent.
#
# All of this is consumed in one place: lib/enquiry.ts
# ─────────────────────────────────────────────────────────────────────────────

# ── OPTION A · any webhook ───────────────────────────────────────────────────
# Works with Formspree, Zapier, Make, n8n, Slack incoming webhooks, or your own
# CRM endpoint. Receives a JSON body containing every field plus a `reference`,
# a `receivedAt` timestamp and a preformatted `summary` string.
# Tried first when both options are configured.
ENQUIRY_WEBHOOK_URL=
# Optional. Sent as the `X-Aevoura-Signature` header so your endpoint can
# verify the request actually came from this site.
ENQUIRY_WEBHOOK_SECRET=

# ── OPTION B · transactional email via Resend ────────────────────────────────
# Uses the REST API directly — no SDK dependency to keep up to date.
RESEND_API_KEY=
# Where enquiries land. Falls back to site.contact.email in lib/site.ts.
ENQUIRY_TO_EMAIL=
# Must be a sender you have verified with Resend. Required for this option.
ENQUIRY_FROM_EMAIL=
